# ============================================================================
# EvalAI backend configuration
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================================

# --- Application ---
ENV=development                       # development | production | test
DEBUG=true
API_V1_PREFIX=/api/v1
PROJECT_NAME=EvalAI

# --- Database ---
# Production: PostgreSQL.  Local quickstart / tests may use sqlite.
DATABASE_URL=postgresql+psycopg2://evalai:evalai@localhost:5432/evalai
# DATABASE_URL=sqlite:///./evalai.db

# --- Redis / Celery ---
# If REDIS_URL is empty, Celery runs tasks inline (eager) so the API works
# without a broker for local development. Set it for real async processing.
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false

# --- JWT ---
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14

# --- AI provider ---
AI_PROVIDER=groq                      # mock | anthropic | openai | groq
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=                      # optional: point at an OpenAI-compatible gateway
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b         # 20b is fast + has generous free-tier limits; 120b is higher quality but rate-limited
GROQ_BASE_URL=https://api.groq.com/openai/v1
AI_MAX_RETRIES=1
AI_TIMEOUT_SECONDS=60
AI_RATE_LIMIT_RETRIES=3
EAGER_SCENARIO_GENERATION=false       # false: each student's scenario is generated on first open (saves tokens for big classes)
AI_SCENARIO_GEN_DELAY_MS=400

# --- File storage ---
STORAGE_BACKEND=local                 # local | s3
STORAGE_PATH=./uploads
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=evalai
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Upload / ZIP limits ---
MAX_UPLOAD_SIZE=52428800              # 50 MB (compressed archive cap)
MAX_ZIP_FILES=400
MAX_UNCOMPRESSED_SIZE=262144000       # 250 MB total extracted
MAX_ZIP_RATIO=120                     # max uncompressed/compressed ratio (zip-bomb guard)
MAX_ZIP_DEPTH=1                       # nested-archive depth allowed

# --- SQL sandbox ---
SQL_SANDBOX_TIMEOUT_SECONDS=5
SQL_SANDBOX_MAX_ROWS=10000

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# --- Business rules ---
MAX_ACTIVE_SUBJECTS=50

# --- Bootstrap admin (used by scripts/create_admin.py only) ---
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=
FIRST_ADMIN_NAME=Platform Admin
